<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ArcadeShareServer</RootNamespace>
    <AssemblyName>ArcadeShareServer</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Métadonnées NuGet -->
    <PackageId>ArcadeShare</PackageId>
	<Title>Arcade Share</Title>
    <Version>3.0.0</Version>
    <Authors>La_TNT</Authors>
    <Description>Bibliothèque .NET pour créer des salles de partage et de synchronisation audio en temps réel via WebSocket.</Description>
    <RepositoryUrl>https://github.com/Audio-Arcade/ArcadeShare</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
